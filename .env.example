# Database Configuration
# Replace these values with your actual database credentials

DB_HOST=your-database-host.com
DB_PORT=3307
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Flask Secret Key (REQUIRED)
# Used for session management and JWT token signing
# Generate a secure key by running: python3 -c "import secrets; print(secrets.token_hex(32))"
# NEVER use the same key across different environments or commit your actual key to version control
SECRET_KEY=your_secret_key_here_generate_a_new_one

# HTTPS Configuration
# Set to 'True' in production when HTTPS is enabled (forces secure cookies)
# Keep as 'False' in development for HTTP localhost access
HTTPS_ENABLED=True_or_False

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Leave empty in development to auto-allow localhost
CORS_ALLOWED_ORIGINS=

# Rate Limiting Configuration
# Adjust these values based on your security requirements
# Format: number per time_period (e.g., "5 per 15 minutes", "100 per hour")
RATE_LIMIT_LOGIN=5 per 15 minutes
RATE_LIMIT_REGISTER=3 per hour
RATE_LIMIT_CHANGE_PASSWORD=3 per hour
RATE_LIMIT_ADMIN=30 per minute
RATE_LIMIT_API=100 per minute

# Backup Trigger Whitelist
# Comma-separated list of allowed origins for backup trigger endpoint
BACKUP_ALLOWED_ORIGINS=your_cron_service_origins_here

# ============================================================================
# INTEGRATION CREDENTIALS
# ============================================================================
# Gemini AI API Key is stored in the database (ai_provider_config table).
# Google Drive credentials are stored in the database (app_settings table).
# Manage them via Admin → Settings in the web UI.

# Backup Encryption Password (for password-protected zip files)
# Use a strong, unique password different from your admin password
BACKUP_ENCRYPTION_PASSWORD=your_strong_backup_password_here
# =============================================================================
# PARKING QR NOTIFIER (/park) — see docs/PARKING_QR_PLAN.md
# =============================================================================
# Secret used to derive QR tokens. Set it explicitly: if left empty it is derived
# from SECRET_KEY, and rotating SECRET_KEY would then invalidate every printed QR.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
PARK_QR_SECRET=
# Public base URL encoded into QR codes (do not rely on the Host header in production)
PARK_PUBLIC_BASE_URL=https://your-domain.example
# Google reCAPTCHA v2 ("I'm not a robot" checkbox). Requests fail closed if unset.
# Google's public TEST keys (always pass, for local dev only):
#   site:   6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
#   secret: 6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum seconds between pushes to the same vehicle (extra scans are logged as 'throttled')
PARK_NOTIFY_COOLDOWN_SECONDS=60
# Back-office session lifetime in hours
PARK_SESSION_HOURS=12
RATE_LIMIT_PARK_NOTIFY=5 per 10 minutes
RATE_LIMIT_PARK_SCAN_PAGE=30 per minute
